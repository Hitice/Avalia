<IfModule mod_rewrite.c>
    <IfModule mod_negotiation.c>
        Options -MultiViews -Indexes
    </IfModule>

    RewriteEngine On

    # Handle Authorization Header
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # Handle X-XSRF-Token Header
    RewriteCond %{HTTP:x-xsrf-token} .
    RewriteRule .* - [E=HTTP_X_XSRF_TOKEN:%{HTTP:X-XSRF-Token}]

    # Redirect Trailing Slashes If Not A Folder...
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_URI} (.+)/$
    RewriteRule ^ %1 [L,R=301]

    # Send Requests To Front Controller...
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^ index.php [L]
</IfModule>

# ---------------------------------------------------------------------------
# Cache do que nao muda
# ---------------------------------------------------------------------------
#
# O F5 era o problema: sem cabecalho de cache, o navegador pergunta de novo por
# CADA arquivo a cada recarga. Numa pagina com CSS, JS, fontes e meia duzia de
# imagens, isso vira uma rajada de conexoes simultaneas, e e ai que a
# hospedagem compartilhada devolve 503 por falta de processo livre.
#
# Os arquivos do Vite levam o hash do conteudo no nome (app-DqK4vmWN.css), e
# por isso podem ser `immutable`: mudou o conteudo, mudou o nome, e o navegador
# busca o novo sem precisar perguntar pelo velho. Um ano e o teto que a
# especificacao aceita.
#
# As imagens nao tem hash no nome, entao levam prazo menor: uma semana, com
# `must-revalidate` para a troca de uma foto aparecer sem esperar o prazo
# inteiro.
#
# O HTML fica de fora de proposito. Ele carrega o token de CSRF e muda conforme
# quem esta logado: guardado num cache compartilhado, uma pessoa receberia a
# pagina de outra, e o formulario de contato passaria a recusar todo envio com
# "pagina expirada".
<IfModule mod_headers.c>
    <FilesMatch "\.(css|js|woff2|woff|ttf|eot)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>

    <FilesMatch "\.(webp|png|jpe?g|gif|svg|ico|avif)$">
        Header set Cache-Control "public, max-age=604800, must-revalidate"
    </FilesMatch>
</IfModule>

# Compressao do que e texto. As imagens ja saem comprimidas, e comprimir de
# novo so gasta CPU do servidor, que e justamente o que esta faltando.
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml application/javascript application/json image/svg+xml
</IfModule>
