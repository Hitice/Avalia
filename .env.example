APP_NAME=Avalia
APP_VERSION=1.0.0
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8000
APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=pt_BR
APP_FAKER_LOCALE=pt_BR
APP_TIMEZONE=America/Sao_Paulo

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=daily
LOG_LEVEL=info
AUDIT_LOG_DAYS=90
SECURITY_LOG_DAYS=90

# Chave de API usada para criar e consultar cobrancas no Asaas. Sem ela, a
# cobranca permanece registrada na Avalia e nao e enviada ao provedor.
ASAAS_API_KEY=
# Segredo que valida os avisos recebidos do Asaas. Sem ele, avisos externos sao recusados.
ASAAS_WEBHOOK_TOKEN=
# Endereco da API do Asaas para o ambiente contratado.
ASAAS_BASE_URL=https://api-sandbox.asaas.com/v3

# --- Banco -------------------------------------------------------------------
# A aplicacao roda em PostgreSQL ou MySQL. Ela nao usa recurso exclusivo de
# nenhum dos dois, e a suite inteira passa em SQLite.
#
# MySQL da Hostinger (hPanel > Bancos de dados MySQL). O host e localhost porque
# o banco fica na mesma maquina: nome e usuario ja vem com o prefixo da conta.
# DB_CONNECTION=mysql
# DB_HOST=localhost
# DB_PORT=3306
# DB_DATABASE=uXXXXXXXXX_avalia
# DB_USERNAME=uXXXXXXXXX_admin
# DB_PASSWORD=
#
# PostgreSQL: no Supabase, Project Settings > Database > Connection string
# (modo Session). DB_SSLMODE nao existe no MySQL e so vale aqui.
DB_CONNECTION=pgsql
DB_HOST=
DB_PORT=5432
DB_DATABASE=postgres
DB_USERNAME=
DB_PASSWORD=
DB_SSLMODE=require

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=file

MAIL_MAILER=log

# --- Superusuario (semeado pelo AcessoSeeder) --------------------------------
ADMIN_NOME=Administrador
ADMIN_EMAIL=admin@avalia.local
ADMIN_SENHA=

VITE_APP_NAME="${APP_NAME}"

# Reaproveita a conexao entre requisicoes. Ligue so em desenvolvimento:
# em producao cada worker php-fpm seguraria uma conexao aberta.
DB_PERSISTENT=false

# Manda a consulta numa ida so, em vez de prepare + execute separados.
# Vale muito com banco remoto; irrelevante com banco local.
DB_EMULA_PREPARE=false
