APP_NAME=Avalia
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8000
APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=pt_BR
APP_FAKER_LOCALE=pt_BR
APP_TIMEZONE=America/Sao_Paulo

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=daily
LOG_LEVEL=info
AUDIT_LOG_DAYS=90
SECURITY_LOG_DAYS=90

# --- Banco -------------------------------------------------------------------
# Supabase: Project Settings > Database > Connection string (modo Session).
DB_CONNECTION=pgsql
DB_HOST=
DB_PORT=5432
DB_DATABASE=postgres
DB_USERNAME=
DB_PASSWORD=
DB_SSLMODE=require

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=file

MAIL_MAILER=log

# --- Superusuario (semeado pelo AcessoSeeder) --------------------------------
ADMIN_NOME=Administrador
ADMIN_EMAIL=admin@avalia.local
ADMIN_SENHA=

VITE_APP_NAME="${APP_NAME}"

# Reaproveita a conexao entre requisicoes. Ligue so em desenvolvimento:
# em producao cada worker php-fpm seguraria uma conexao aberta.
DB_PERSISTENT=false

# Manda a consulta numa ida so, em vez de prepare + execute separados.
# Vale muito com banco remoto; irrelevante com banco local.
DB_EMULA_PREPARE=false
